# ─────────────────────────────────────────────────────────────
#  این فایل الگوست. یک کپی به نام .env.local بسازید و پرش کنید:
#      cp .env.example .env.local
#  فایل .env.local هرگز کامیت نمی‌شود (در .gitignore است).
# ─────────────────────────────────────────────────────────────

# رشته اتصال PostgreSQL — الزامی
#
# روی سرور (Neon، Supabase، Vercel Postgres و…) رشته‌ای که پنل به شما
# می‌دهد را همین‌جا بگذارید. برنامه برای هر میزبانی به‌جز localhost
# خودش SSL را روشن می‌کند.
#
#   نمونه سرور : postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#   نمونه محلی : postgres://postgres:رمز@localhost:5432/khanum
DATABASE_URL=

# کلید امضای کوکی نشست — الزامی
#
# با این کلید، کوکی ورود کاربران امضا می‌شود. یک رشته تصادفی بلند بگذارید
# و آن را جایی امن نگه دارید. اگر عوضش کنید، همه کاربران از حساب خارج
# می‌شوند (رمزهایشان سالم می‌ماند).
#
# برای ساختن یک کلید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
